rules_version = '2';

// The backend talks to Firestore through the Admin SDK, which bypasses these
// rules. They exist to make sure NOBODY ELSE can: no browser, no mobile app,
// no leaked web API key. All access goes through the API, which checks the
// caller's token and scopes every query to their own uid.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
